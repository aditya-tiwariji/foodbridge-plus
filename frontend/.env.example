# FoodBridge Frontend - Environment Variables Template

# Base API URL of the deployed backend server (e.g. https://foodbridge-api.onrender.com/api/v1)
# For local development, fallback defaults to http://localhost:5001/api/v1
VITE_API_URL=https://your-foodbridge-api-url.com/api/v1

# Base Socket.io server URL (e.g. https://foodbridge-api.onrender.com)
# For local development, fallback defaults to VITE_API_URL with '/api/v1' stripped
VITE_SOCKET_URL=https://your-foodbridge-api-url.com
